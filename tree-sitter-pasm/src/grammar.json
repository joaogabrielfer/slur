          "type": "FIELD",
          "name": "keyword",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "STRING",
              "value": "when"
            },
            "named": true,
            "value": "keyword"
          }
        },
        {
          "type": "SYMBOL",
          "name": "block"
        }
      ]
    },
    "block": {
