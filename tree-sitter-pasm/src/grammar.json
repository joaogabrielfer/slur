            "type": "STRING",
            "value": ";;"
          },
          {
            "type": "PATTERN",
            "value": "[^\\n]*"
          }
        ]
      }
    },
    "function_literal": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "signature"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
